{
  "name": "km-deliberation-v2-wire",
  "protocolVersion": 1,
  "authority": "state/deliberation-v2/spool.sqlite3",
  "initializationCommand": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=scripts:lib .venv/bin/python3 scripts/deliberation-v2.py health",
  "mediaType": "application/json",
  "closedSchemas": true,
  "readinessPolicy": {"fixedSeconds": 60, "deadlineAuthority": "authenticatedEvent.receivedAt + 60 seconds", "freshOrder": ["readyAt", "recordId"], "closedAt": "scheduler observation only"},
  "applicationHeaders": ["Authorization", "X-Deliberation-Protocol-Version", "Accept", "Content-Type"],
  "transportHeaders": ["Host", "Content-Length", "Connection", "User-Agent", "Accept-Encoding", "Accept-Language", "Sec-Fetch-Mode"],
  "authentication": {
    "comparison": "constant-time",
    "credentialArguments": ["--credential-file", "DELIBERATION_V2_CREDENTIAL_FILE"],
    "credentialFile": "regular file, no symlink, mode 0600 or stricter, one UTF-8 line, 16..256 bytes",
    "diagnostics": "credential value and path are never returned or logged"
  },
  "sourceIdentity": {
    "version": "v1",
    "grammar": "v1:<provider>:<account>:<channel>",
    "pattern": "^v1:[a-z][a-z0-9_-]{0,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,95}:[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$",
    "providerPattern": "^[a-z][a-z0-9_-]{0,31}$",
    "accountPattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$",
    "channelPattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$",
    "providerAgreement": "intake provider must exactly equal the provider component",
    "domain": "the complete sourceTarget is the record, inbound dedupe, payload, correlation and freshness domain; it never groups pending events",
    "syntheticNamespace": {
      "provider": "synthetic",
      "account": "diagnostic",
      "grammar": "v1:synthetic:diagnostic:<id>",
      "rule": "synthetic identities outside the diagnostic account are invalid"
    },
    "historicalCompatibility": {
      "pattern": "^discord:channel:[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$",
      "rule": "stored historical account-less records remain readable and auditable but are operationally invalid and cannot append, close, claim, refresh, reserve or merge with v1 domains",
      "validationError": "historical account-less sourceTarget is audit-only"
    }
  },
  "pipelineIdentity": {
    "grammar": "bounded opaque live identifier",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$",
    "historicalMarker": "__historical_v1__",
    "historicalRule": "the reserved historical marker is assigned only by startup migration and is rejected on live intake"
  },
  "listener": {
    "hosts": ["127.0.0.1", "::1"],
    "explicitHostRequired": true,
    "maxBodyBytes": 65536,
    "headerReadSeconds": 5,
    "bodyReadSeconds": 10,
    "sqliteBusyTimeoutSeconds": 30
  },
  "schemas": {
    "getHeaders": {
      "type": "object",
      "properties": {
        "Authorization": {"type": "string", "minLength": 23, "maxLength": 263, "pattern": "^Bearer [^\\s]+$"},
        "X-Deliberation-Protocol-Version": {"type": "string", "const": "1"},
        "Accept": {"type": "string", "const": "application/json"}
      },
      "required": ["Authorization", "X-Deliberation-Protocol-Version", "Accept"],
      "additionalProperties": false
    },
    "postHeaders": {
      "type": "object",
      "properties": {
        "Authorization": {"type": "string", "minLength": 23, "maxLength": 263, "pattern": "^Bearer [^\\s]+$"},
        "X-Deliberation-Protocol-Version": {"type": "string", "const": "1"},
        "Accept": {"type": "string", "const": "application/json"},
        "Content-Type": {"type": "string", "const": "application/json"}
      },
      "required": ["Authorization", "X-Deliberation-Protocol-Version", "Accept", "Content-Type"],
      "additionalProperties": false
    },
    "emptyQuery": {"type": "object", "properties": {}, "required": [], "additionalProperties": false},
    "readyQuery": {
      "type": "object",
      "properties": {
        "limit": {"type": "string", "minLength": 1, "maxLength": 3, "pattern": "^(100|[1-9][0-9]?)$"},
        "cursor": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$"}
      },
      "required": [],
      "additionalProperties": false
    },
    "noBody": {"type": "null"},
    "deliveryTarget": {
      "type": "object",
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"},
        "account": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"},
        "channel": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"},
        "threadId": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"}
      },
      "required": ["provider", "account", "channel"],
      "additionalProperties": false
    },
    "nullableDeliveryTarget": {"oneOf": [{"$ref": "#/schemas/deliveryTarget"}, {"type": "null"}]},
    "intakeBody": {
      "type": "object",
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "providerEventId": {"type": "string", "minLength": 1, "maxLength": 256},
        "sourceTarget": {"type": "string", "minLength": 8, "maxLength": 229, "pattern": "^v1:[a-z][a-z0-9_-]{0,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,95}:[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"},
        "sourceThreadId": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"},
        "pipelineId": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$", "not": {"const": "__historical_v1__"}},
        "deliveryTarget": {"$ref": "#/schemas/deliveryTarget"},
        "senderId": {"type": "string", "minLength": 1, "maxLength": 256},
        "occurredAt": {"type": "string", "minLength": 20, "maxLength": 64},
        "receivedAt": {"type": "string", "minLength": 20, "maxLength": 64},
        "content": {"type": "string", "minLength": 1, "maxLength": 65536},
        "eventType": {"type": "string", "enum": ["message", "edit", "delete"]}
      },
      "required": ["provider", "providerEventId", "sourceTarget", "pipelineId", "deliveryTarget", "senderId", "occurredAt", "receivedAt", "content"],
      "additionalProperties": false
    },
    "deliveryEnvelope": {
      "type": "object",
      "properties": {
        "schemaVersion": {"type": "integer", "const": 1},
        "pipelineId": {"type": "string", "minLength": 1, "maxLength": 96},
        "sourceTarget": {"type": "string", "minLength": 8, "maxLength": 229, "pattern": "^v1:[a-z][a-z0-9_-]{0,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,95}:[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"},
        "deliveryTarget": {"$ref": "#/schemas/deliveryTarget"},
        "recordId": {"type": "string", "minLength": 1, "maxLength": 256},
        "inboundId": {"type": "string", "minLength": 1, "maxLength": 256},
        "draftAttempt": {"type": "integer", "minimum": 1},
        "draftCorrelationId": {"type": "string", "minLength": 1, "maxLength": 256},
        "reviewAttempt": {"type": "integer", "minimum": 1},
        "reviewCorrelationId": {"type": "string", "minLength": 1, "maxLength": 256},
        "candidateRevision": {"type": "integer", "minimum": 0},
        "reviewedTextHash": {"type": "string", "minLength": 64, "maxLength": 64}
      },
      "required": ["schemaVersion", "pipelineId", "sourceTarget", "deliveryTarget", "recordId", "inboundId", "draftAttempt", "draftCorrelationId", "reviewAttempt", "reviewCorrelationId", "candidateRevision", "reviewedTextHash"],
      "additionalProperties": false
    },
    "reservationBody": {
      "type": "object",
      "properties": {
        "recordId": {"type": "string", "minLength": 1, "maxLength": 256},
        "expectedVersion": {"type": "integer", "minimum": 1},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 256},
        "leaseSeconds": {"type": "integer", "minimum": 1, "maximum": 900}
      },
      "required": ["recordId", "expectedVersion", "owner", "idempotencyKey"],
      "additionalProperties": false
    },
    "completionBody": {
      "type": "object",
      "properties": {
        "recordId": {"type": "string", "minLength": 1, "maxLength": 256},
        "attemptId": {"type": "string", "minLength": 1, "maxLength": 256},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "leaseToken": {"type": "string", "minLength": 1, "maxLength": 256},
        "deliveryEnvelope": {"$ref": "#/schemas/deliveryEnvelope"},
        "deliveryEnvelopeDigest": {"type": "string", "minLength": 64, "maxLength": 64},
        "attemptedTarget": {"$ref": "#/schemas/deliveryTarget"},
        "invocationIdempotencyKey": {"type": "string", "minLength": 1, "maxLength": 256},
        "outcome": {"type": "string", "enum": ["SENT", "FAILED"]},
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 256},
        "providerAttemptId": {"type": "string", "minLength": 1, "maxLength": 256},
        "providerReceiptId": {"type": "string", "minLength": 1, "maxLength": 256},
        "providerMessageId": {"type": "string", "minLength": 1, "maxLength": 256},
        "providerFailureClass": {"type": "string", "enum": ["permission", "rejection", "rate_limit"]},
        "providerEvidence": {"type": "object", "properties": {"code": {"type": "string", "maxLength": 256}, "status": {"type": "integer"}, "retryAfterSeconds": {"type": "integer", "minimum": 0}, "detail": {"type": "string", "maxLength": 2048}}, "additionalProperties": false},
        "proofReference": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "required": ["recordId", "attemptId", "owner", "leaseToken", "deliveryEnvelope", "deliveryEnvelopeDigest", "attemptedTarget", "invocationIdempotencyKey", "outcome", "idempotencyKey", "providerAttemptId"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"outcome": {"const": "SENT"}}}, "then": {"required": ["providerReceiptId", "providerMessageId"]}},
        {"if": {"properties": {"outcome": {"const": "FAILED"}}}, "then": {"required": ["providerFailureClass", "providerEvidence"]}}
      ]
    },
    "invocationBody": {
      "type": "object",
      "properties": {
        "recordId": {"type": "string", "minLength": 1, "maxLength": 256},
        "attemptId": {"type": "string", "minLength": 1, "maxLength": 256},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "leaseToken": {"type": "string", "minLength": 1, "maxLength": 256},
        "deliveryEnvelope": {"$ref": "#/schemas/deliveryEnvelope"},
        "deliveryEnvelopeDigest": {"type": "string", "minLength": 64, "maxLength": 64},
        "attemptedTarget": {"$ref": "#/schemas/deliveryTarget"},
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 256},
        "providerAttemptId": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "required": ["recordId", "attemptId", "owner", "leaseToken", "deliveryEnvelope", "deliveryEnvelopeDigest", "attemptedTarget", "idempotencyKey", "providerAttemptId"],
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "properties": {
        "source-intake": {"type": "boolean"},
        "claims": {"type": "boolean"},
        "review": {"type": "boolean"},
        "sender": {"type": "boolean"}
      },
      "required": ["source-intake", "claims", "review", "sender"],
      "additionalProperties": false
    },
    "readyItem": {
      "type": "object",
      "properties": {
        "recordId": {"type": "string", "minLength": 1, "maxLength": 256},
        "pipelineId": {"type": "string", "minLength": 1, "maxLength": 96},
        "deliveryTarget": {"$ref": "#/schemas/deliveryTarget"},
        "version": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1, "maxLength": 65536},
        "candidateRevision": {"type": "integer", "minimum": 0},
        "updatedAt": {"type": "string", "minLength": 20, "maxLength": 64}
        ,"deliveryEnvelope": {"$ref": "#/schemas/deliveryEnvelope"}
      },
      "required": ["recordId", "pipelineId", "deliveryTarget", "version", "text", "candidateRevision", "updatedAt", "deliveryEnvelope"],
      "additionalProperties": false
    },
    "reservation": {
      "type": "object",
      "properties": {
        "recordId": {"type": "string", "minLength": 1, "maxLength": 256},
        "attemptId": {"type": "string", "minLength": 1, "maxLength": 256},
        "ordinal": {"type": "integer", "minimum": 1},
        "version": {"type": "integer", "minimum": 1},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "leaseToken": {"type": "string", "minLength": 1, "maxLength": 256},
        "leaseExpiresAt": {"type": "string", "minLength": 20, "maxLength": 64},
        "candidateRevision": {"type": "integer", "minimum": 0},
        "reviewedTextHash": {"type": "string", "minLength": 64, "maxLength": 64},
        "deliveryEnvelope": {"$ref": "#/schemas/deliveryEnvelope"},
        "deliveryEnvelopeDigest": {"type": "string", "minLength": 64, "maxLength": 64}
      },
      "required": ["recordId", "attemptId", "ordinal", "version", "owner", "leaseToken", "leaseExpiresAt", "candidateRevision", "reviewedTextHash", "deliveryEnvelope", "deliveryEnvelopeDigest"],
      "additionalProperties": false
    },
    "deliveryAttempt": {
      "type": "object",
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "attemptId": {"type": "string", "minLength": 1, "maxLength": 256},
        "candidateRevision": {"type": "integer", "minimum": 0},
        "reviewedTextHash": {"type": "string", "minLength": 64, "maxLength": 64},
        "reservedRecordVersion": {"type": "integer", "minimum": 1},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "leaseExpiresAt": {"type": "string", "minLength": 20, "maxLength": 64},
        "completionOutcome": {"type": ["string", "null"], "enum": ["SENT", "FAILED", "RESERVATION_ABANDONED", "NOT_SENT", "DELIVERY_UNKNOWN", null]},
        "outcome": {"type": ["string", "null"], "enum": ["SENT", "FAILED", "RESERVATION_ABANDONED", "NOT_SENT", "DELIVERY_UNKNOWN", null]},
        "providerAttemptId": {"type": ["string", "null"], "maxLength": 256},
        "providerReceiptId": {"type": ["string", "null"], "maxLength": 256},
        "providerMessageId": {"type": ["string", "null"], "maxLength": 256},
        "proofReference": {"type": ["string", "null"], "maxLength": 256},
        "reservedAt": {"type": "string", "minLength": 20, "maxLength": 64},
        "completedAt": {"type": ["string", "null"], "maxLength": 64},
        "reconciledAt": {"type": ["string", "null"], "maxLength": 64},
        "deliveryEnvelope": {"type": ["object", "null"], "properties": {"schemaVersion": {"type": "integer"}, "pipelineId": {"type": "string"}, "sourceTarget": {"type": "string"}, "deliveryTarget": {"$ref": "#/schemas/deliveryTarget"}, "recordId": {"type": "string"}, "inboundId": {"type": "string"}, "draftAttempt": {"type": "integer"}, "draftCorrelationId": {"type": "string"}, "reviewAttempt": {"type": "integer"}, "reviewCorrelationId": {"type": "string"}, "candidateRevision": {"type": "integer"}, "reviewedTextHash": {"type": "string"}}, "required": ["schemaVersion", "pipelineId", "sourceTarget", "deliveryTarget", "recordId", "inboundId", "draftAttempt", "draftCorrelationId", "reviewAttempt", "reviewCorrelationId", "candidateRevision", "reviewedTextHash"], "additionalProperties": false},
        "deliveryEnvelopeDigest": {"type": ["string", "null"], "maxLength": 64},
        "reserveIdempotencyKey": {"type": "string", "maxLength": 256},
        "invocationIdempotencyKey": {"type": ["string", "null"], "maxLength": 256},
        "completionIdempotencyKey": {"type": ["string", "null"], "maxLength": 256},
        "invokedAt": {"type": ["string", "null"], "maxLength": 64},
        "attemptedTarget": {"$ref": "#/schemas/nullableDeliveryTarget"},
        "providerFailureClass": {"type": ["string", "null"], "enum": ["permission", "rejection", "rate_limit", null]},
        "providerEvidence": {"type": ["object", "null"], "properties": {"code": {"type": "string"}, "status": {"type": "integer"}, "retryAfterSeconds": {"type": "integer"}, "detail": {"type": "string"}}, "additionalProperties": false},
        "terminalReason": {"type": ["string", "null"], "enum": ["delivery_sent", "delivery_failed", "delivery_outcome_unknown", "reservation_abandoned", null]}
      },
      "required": ["ordinal", "attemptId", "completionOutcome", "outcome", "providerAttemptId", "providerReceiptId", "providerMessageId", "proofReference", "completedAt", "deliveryEnvelope", "deliveryEnvelopeDigest", "reserveIdempotencyKey"],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
