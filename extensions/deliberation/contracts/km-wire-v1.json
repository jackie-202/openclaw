        "readyAt": {"type": ["string", "null"]},
        "closedAt": {"type": ["string", "null"]},
        "state": {"type": "string", "enum": ["READY_TO_SEND", "SENDING", "SENT", "FAILED", "DELIVERY_UNKNOWN"]},
        "version": {"type": "integer", "minimum": 1},
        "duplicateCount": {"type": "integer", "minimum": 0},
        "lease": {"type": ["object", "null"], "properties": {"owner": {"type": "string"}, "token": {"type": "string"}, "expiresAt": {"type": "string"}}, "required": ["owner", "token", "expiresAt"], "additionalProperties": false},
        "drafting": {"type": ["object", "null"], "properties": {"attempt": {"type": "integer"}, "correlationId": {"type": "string"}, "payloadPath": {"type": "string"}, "resultPath": {"type": "string"}, "outcome": {"type": ["string", "null"]}, "diagnostic": {"type": ["object", "null"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 64}, "message": {"type": "string", "minLength": 1, "maxLength": 512}}, "required": ["code", "message"], "additionalProperties": false}, "blocked": {"type": "boolean"}, "result": {"type": ["object", "null"], "properties": {"decision": {"type": "string"}, "draft": {"type": "string"}}, "additionalProperties": false}, "purpose": {"type": "string"}, "candidateRevision": {"type": "integer"}, "technicalAttempt": {"type": "integer"}}, "additionalProperties": false},
        "processing": {"type": ["object", "null"], "properties": {"phase": {"type": "string"}, "attempt": {"type": "integer"}, "purpose": {"type": "string"}, "candidateRevision": {"type": "integer"}, "correlationId": {"type": "string"}, "processingSessionKey": {"type": ["string", "null"]}, "dispatchStartedAt": {"type": ["string", "null"]}, "acknowledgedAt": {"type": ["string", "null"]}, "resultDeadline": {"type": ["string", "null"]}, "expiredAt": {"type": ["string", "null"]}, "releasedAt": {"type": ["string", "null"]}, "releaseReason": {"type": ["string", "null"], "enum": ["result_finalized", "source_history_unavailable", "transport_rejected", "processing_session_timeout", "malformed_draft_result", "draft_result_correlation_conflict", null]}, "lateResult": {"type": ["object", "null"], "properties": {"event": {"type": "string", "const": "LATE_RESULT_AFTER_EXPIRY"}, "classification": {"type": "string", "enum": ["valid", "malformed", "correlation_conflict"]}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "auditedAt": {"type": "string"}}, "required": ["event", "classification", "digest", "auditedAt"], "additionalProperties": false}}, "additionalProperties": false},
        "processingSessionKey": {"type": ["string", "null"]},
        "sourceContext": {"type": ["object", "null"], "properties": {"schemaVersion": {"type": "integer"}, "sourceTarget": {"type": "string"}, "provenance": {"type": "object", "properties": {"provider": {"type": "string"}, "account": {"type": "string"}, "channel": {"type": "string"}}, "additionalProperties": false}, "cutoffProviderEventId": {"type": "string"}, "capturedAt": {"type": "string"}, "snapshotHash": {"type": "string"}, "messages": {"type": "array", "items": {"type": "object", "properties": {}, "additionalProperties": false}}}, "additionalProperties": false},
        "review": {"type": ["object", "null"], "properties": {"candidateRevision": {"type": "integer"}, "rewriteCount": {"type": "integer"}, "attempts": {"type": "array", "items": {"type": "object", "properties": {"attempt": {"type": "integer"}, "technicalAttempt": {"type": "integer"}, "candidateRevision": {"type": "integer", "minimum": 0}, "correlationId": {"type": "string"}, "startedAt": {"type": "string"}, "completedAt": {"type": ["string", "null"]}, "sessionId": {"type": ["string", "null"]}, "provider": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "freshnessCount": {"type": "integer"}, "freshnessHash": {"type": ["string", "null"]}, "freshnessCutoff": {"type": ["string", "null"]}, "freshnessComplete": {"type": "boolean"}, "freshnessArtifactPath": {"type": ["string", "null"]}, "freshnessArtifactDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "reviewContractVersion": {"type": ["integer", "null"], "enum": [1, null]}, "reviewInputVersion": {"type": ["integer", "null"], "enum": [1, null]}, "qualityRubricVersion": {"type": ["integer", "null"], "enum": [1, null]}, "canonicalInputDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "candidateDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "verdict": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"]}, "outcome": {"type": ["string", "null"]}}, "additionalProperties": false}}, "freshnessArtifacts": {"type": "array", "items": {"type": "object", "properties": {"schemaVersion": {"const": 1}, "candidateRevision": {"type": "integer"}, "sourceTarget": {"type": "string"}, "provenance": {"type": "object", "properties": {"provider": {"const": "discord"}, "account": {"type": "string"}, "channel": {"type": "string"}}, "additionalProperties": false}, "exclusiveCutoffProviderEventId": {"type": "string"}, "inclusiveWatermarkProviderEventId": {"type": "string"}, "capturedAt": {"type": "string"}, "messageCount": {"type": "integer"}, "complete": {"type": "boolean"}, "path": {"type": "string"}, "digest": {"type": "string"}}, "additionalProperties": false}}}, "additionalProperties": false},
        "delivery": {"type": "object", "properties": {"attempts": {"type": "array", "items": {"$ref": "#/schemas/deliveryAttempt"}}}, "required": ["attempts"], "additionalProperties": false},
        "candidateRevision": {"type": "integer", "minimum": 0},
        "rewriteCount": {"type": "integer", "minimum": 0},
        "retryStage": {"type": ["string", "null"]},
        "retryDeadline": {"type": ["string", "null"]},
        "terminalReason": {"type": ["string", "null"], "maxLength": 512},
        "history": {"type": "array", "items": {"type": "object", "properties": {"sequence": {"type": "integer"}, "event": {"type": "string"}, "fromState": {"type": ["string", "null"]}, "toState": {"type": ["string", "null"]}, "version": {"type": "integer"}, "occurredAt": {"type": "string"}, "details": {"type": ["object", "null"], "properties": {"attemptId": {"type": "string"}, "ordinal": {"type": "integer"}, "owner": {"type": "string"}, "outcome": {"type": "string"}, "proofReference": {"type": "string"}}, "additionalProperties": false}}, "required": ["sequence", "event", "fromState", "toState", "version", "occurredAt", "details"], "additionalProperties": false}},
        "valid": {"type": "boolean"},
