{
  "id": "deliberation",
  "name": "Deliberation",
  "description": "Fail-closed Discord and Slack intake backed by the Deliberation KM.",
  "expectedHooks": [
    "inbound_event_policy",
    "inbound_claim",
    "before_dispatch",
    "before_tool_call",
    "message_sending"
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "$ref": "#/$defs/canonicalConfig",
    "$defs": {
      "canonicalConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "failClosed", "pipelines", "processingSource", "km", "restrictedSessionKeys"],
        "properties": {
          "enabled": { "type": "boolean" },
          "failClosed": { "const": true },
          "pipelines": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/pipeline" }
          },
          "processingSource": { "$ref": "#/$defs/discordRoute" },
          "km": { "$ref": "#/$defs/km" },
          "restrictedSessionKeys": { "$ref": "#/$defs/restrictedSessionKeys" }
        }
      },
      "pipeline": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]{0,255}$"
          },
          "source": { "$ref": "#/$defs/sourceRoute" },
          "target": { "$ref": "#/$defs/pipelineTarget" }
        }
      },
      "sourceRoute": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "accountId", "target"],
        "properties": {
          "channel": { "enum": ["discord", "slack"] },
          "accountId": { "$ref": "#/$defs/identityComponent" },
          "target": { "$ref": "#/$defs/identityComponent" }
        }
      },
      "discordRoute": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "accountId", "target"],
        "properties": {
          "channel": { "const": "discord" },
          "accountId": { "$ref": "#/$defs/identityComponent" },
          "target": { "$ref": "#/$defs/identityComponent" }
        }
      },
      "pipelineTarget": {
        "oneOf": [
          { "$ref": "#/$defs/discordPipelineTarget" },
          { "$ref": "#/$defs/slackPipelineTarget" }
        ]
      },
      "discordPipelineTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "accountId", "target"],
        "properties": {
          "channel": { "const": "discord" },
          "accountId": { "$ref": "#/$defs/identityComponent" },
          "target": { "$ref": "#/$defs/identityComponent" },
          "threadId": { "$ref": "#/$defs/identityComponent" }
        }
      },
      "slackPipelineTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "accountId", "target"],
        "properties": {
          "channel": { "const": "slack" },
          "accountId": { "$ref": "#/$defs/identityComponent" },
          "target": { "$ref": "#/$defs/identityComponent" },
          "threadId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^\\d+\\.\\d+$"
          }
        }
      },
      "identityComponent": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"
      },
      "km": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint", "credential", "requestTimeoutMs"],
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^(?:https://[^/?#@]+|http://(?:127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?)(?:/[^?#]*)?$"
          },
          "credential": { "type": ["string", "object"] },
          "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
        }
      },
      "restrictedSessionKeys": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        { "path": "km.credential", "expected": "string" }
      ]
    }
  }
}
