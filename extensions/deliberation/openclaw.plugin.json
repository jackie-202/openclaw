{
  "id": "deliberation",
  "name": "Deliberation",
  "description": "Fail-closed Discord and Slack intake backed by the Deliberation KM.",
  "expectedHooks": [
    "inbound_claim",
    "before_dispatch",
    "before_tool_call",
    "message_sending"
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["enabled", "failClosed", "sources", "processingSource", "km", "restrictedSessionKeys"],
    "properties": {
      "enabled": { "type": "boolean" },
      "failClosed": { "const": true },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/sourceRoute" }
      },
      "processingSource": { "$ref": "#/$defs/discordRoute" },
      "deliveryTarget": { "$ref": "#/$defs/deliveryTarget" },
      "km": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint", "credential", "requestTimeoutMs"],
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^(?:https://[^/?#@]+|http://(?:127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?)(?:/[^?#]*)?$"
          },
          "credential": { "type": ["string", "object"] },
          "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
        }
      },
      "restrictedSessionKeys": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "$defs": {
      "sourceRoute": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "accountId", "target"],
        "properties": {
          "channel": { "enum": ["discord", "slack"] },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"
          }
        }
      },
      "discordRoute": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "accountId", "target"],
        "properties": {
          "channel": { "const": "discord" },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"
          }
        }
      },
      "deliveryTarget": {
        "oneOf": [
          { "$ref": "#/$defs/discordDeliveryTarget" },
          { "$ref": "#/$defs/slackDeliveryTarget" }
        ]
      },
      "discordDeliveryTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "accountId", "channelId"],
        "properties": {
          "provider": { "const": "discord" },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"
          },
          "channelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"
          },
          "threadId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"
          }
        }
      },
      "slackDeliveryTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "accountId", "channelId", "threadId"],
        "properties": {
          "provider": { "const": "slack" },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"
          },
          "channelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,95}$"
          },
          "threadId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^\\d+\\.\\d+$"
          }
        }
      }
    }
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        { "path": "km.credential", "expected": "string" }
      ]
    }
  }
}
